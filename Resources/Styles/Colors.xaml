<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Governance branding: navy + white only. NavyLine / PrimaryLight are navy on white at low weight. -->
    <Color x:Key="NavyLine">#C5D3E8</Color>

    <!-- Primary: Deep Navy Blue -->
    <Color x:Key="Primary">#003087</Color>
    <Color x:Key="PrimaryDark">#002165</Color>
    <Color x:Key="PrimaryLight">#EEF2FA</Color>
    <Color x:Key="PrimaryMid">#1A4BA0</Color>
    <Color x:Key="PrimaryDarkText">#0D1E3D</Color>

    <!-- Secondary: Soft navy tint -->
    <Color x:Key="Secondary">#F4F6FB</Color>
    <Color x:Key="SecondaryDarkText">#5A6E8A</Color>

    <!-- Accent colors -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="InfoColor">#2563EB</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Tertiary">#1A4BA0</Color>
    <Color x:Key="MidnightBlue">#0D1E3D</Color>
    <Color x:Key="OffBlack">#1A2B4B</Color>

    <!-- Neutral blue-gray scale -->
    <Color x:Key="Gray50">#F4F6FB</Color>
    <Color x:Key="Gray100">#EEF2FA</Color>
    <Color x:Key="Gray200">#E0E8F5</Color>
    <Color x:Key="Gray300">#C5D3E8</Color>
    <Color x:Key="Gray400">#8FA3BF</Color>
    <Color x:Key="Gray500">#5A6E8A</Color>
    <Color x:Key="Gray600">#3D5069</Color>
    <Color x:Key="Gray700">#273B52</Color>
    <Color x:Key="Gray900">#0D1E3D</Color>
    <Color x:Key="Gray950">#060F1F</Color>

    <!-- Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Gray Brushes -->
    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>