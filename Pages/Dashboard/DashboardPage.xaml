<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Dashboard.DashboardPage"
             BackgroundColor="{StaticResource White}"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid BackgroundColor="{StaticResource Primary}" Padding="20,22,20,28">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="UserNameLabel" Text=""
                           FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Border BackgroundColor="{StaticResource PrimaryMid}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,6"
                            HorizontalOptions="Start">
                        <Label x:Name="UserRoleLabel" Text=""
                               FontSize="12" FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                    <Label x:Name="ResponsibilityHintLabel"
                           Text=""
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.9"
                           LineBreakMode="WordWrap"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,16,16,22" Spacing="16">

                <!-- What needs attention -->
                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="What needs your attention"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="NeedsAttentionLabel"
                               Text=""
                               FontSize="12"
                               TextColor="{StaticResource PrimaryDarkText}"
                               LineBreakMode="WordWrap" />
                        <Button Text="Go to Pending Approvals"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                Padding="14,12"
                                Clicked="OnGoToPendingApprovalsBrowseClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
