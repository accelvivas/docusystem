<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Dashboard.DashboardPage"
             BackgroundColor="{StaticResource White}"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid BackgroundColor="{StaticResource Primary}" Padding="20,22,20,28">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="UserNameLabel" Text=""
                           FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Border BackgroundColor="{StaticResource PrimaryMid}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,6"
                            HorizontalOptions="Start">
                        <Label x:Name="UserRoleLabel" Text=""
                               FontSize="12" FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                    <Label x:Name="ResponsibilityHintLabel"
                           Text=""
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.9"
                           LineBreakMode="WordWrap"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,16,16,22" Spacing="16">

                <!-- What needs attention -->
                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="What needs your attention"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="NeedsAttentionLabel"
                               Text=""
                               FontSize="12"
                               TextColor="{StaticResource PrimaryDarkText}"
                               LineBreakMode="WordWrap" />
                        <Button Text="Go to Pending Approvals"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                Padding="14,12"
                                Clicked="OnGoToPendingApprovalsBrowseClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Summary"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10">

                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="{StaticResource NavyLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="PENDING APPROVALS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Opacity="0.78" />
                            <Label x:Name="PendingApprovalsCountLabel"
                                   Text="0"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="{StaticResource NavyLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="FOR REVISION FOLLOW-UP"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Opacity="0.78" />
                            <Label x:Name="RevisionFollowUpCountLabel"
                                   Text="0"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="{StaticResource NavyLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="APPROVED THIS WEEK"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Opacity="0.78" />
                            <Label x:Name="ApprovedThisWeekCountLabel"
                                   Text="0"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="{StaticResource NavyLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="REJECTED / RETURNED THIS WEEK"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Opacity="0.78" />
                            <Label x:Name="RejectedReturnedWeekCountLabel"
                                   Text="0"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2"
                            BackgroundColor="White"
                            Stroke="{StaticResource NavyLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="OVERDUE ITEMS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Opacity="0.78" />
                            <Label x:Name="OverdueItemsCountLabel"
                                   Text="0"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
