<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Forms.ProposalFormPage"
             BackgroundColor="{StaticResource White}"
             Title="Proposal form">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid BackgroundColor="#003087" Padding="18,16,18,22">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Activity proposal form"
                           FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="FormContextSubtitleLabel"
                           Text=""
                           FontSize="11" TextColor="White" Opacity="0.9" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,14,16,24" Spacing="12">

                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="{StaticResource NavyLine}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Official template — fill in order from top to bottom."
                               FontSize="11"
                               TextColor="{StaticResource PrimaryDarkText}"
                               LineBreakMode="WordWrap" />
                        <Label x:Name="ProposalFormAccessHintLabel"
                               Text=""
                               FontSize="12" TextColor="{StaticResource PrimaryDarkText}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- 1. Header / Organization -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Header / organization" Style="{StaticResource SectionTitle}" />

                        <HorizontalStackLayout Spacing="14" VerticalOptions="Start">
                            <Border WidthRequest="72" HeightRequest="72"
                                    Stroke="#C5D3E8" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#EEF2FA"
                                    VerticalOptions="Start">
                                <Label Text="Logo"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       FontSize="11" TextColor="#8FA3BF" />
                            </Border>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="FillAndExpand">
                                <Label Text="NU Lipa" FontSize="16" FontAttributes="Bold" TextColor="#003087" />
                                <Label Text="Header fields"
                                       FontSize="11" TextColor="#8FA3BF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name of Organization" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="OrganizationNameEntry" Placeholder="RSO / organization name" BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="OrganizationNameValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="School" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="SchoolEntry" Placeholder="School / campus" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Department / Program" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="DepartmentProgramEntry" Placeholder="Department or program" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Academic Year" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="AcademicYearEntry" Placeholder="e.g., 2025–2026" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Project / Activity Information -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Project / activity information" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Project / Activity Title" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ProjectTitleEntry" Placeholder="Title" BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="ProjectTitleValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proposed Date(s)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="ProposedDatesEditor"
                                        Placeholder="Date or date range"
                                        MinimumHeightRequest="64"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proposed Time" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ProposedTimeEntry"
                                       Placeholder="e.g., 1:00 PM – 5:00 PM"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Venue" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="VenueEntry" Placeholder="Venue" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Objectives -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Objectives" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Overall Goal / Main Objective" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="MainObjectiveEditor"
                                        Placeholder="Primary goal"
                                        MinimumHeightRequest="80"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Specific Objectives" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="SpecificObjectivesEditor"
                                        Placeholder="Numbered or bulleted objectives"
                                        MinimumHeightRequest="100"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Activity Description -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Activity description" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Criteria / Mechanics" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="CriteriaEditor"
                                        Placeholder="Criteria or mechanics"
                                        MinimumHeightRequest="88"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Program Flow" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="ProgramFlowEditor"
                                        Placeholder="Sequence of program segments"
                                        MinimumHeightRequest="100"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Budget -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Budget" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proposed Budget" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ProposedBudgetEntry"
                                       Placeholder="Total (PHP)"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="BudgetValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Source of Funding" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="FundingSourceEntry" Placeholder="Sources" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="Expenses" FontSize="13" FontAttributes="Bold" TextColor="#003087" Margin="0,4,0,0" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Materials and Supplies" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ExpenseMaterialsEntry" Placeholder="Amount or breakdown" Keyboard="Numeric" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Food and Beverage" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ExpenseFoodEntry" Placeholder="Amount or breakdown" Keyboard="Numeric" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Other Expenses" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ExpenseOtherEntry" Placeholder="Amount or breakdown" Keyboard="Numeric" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 6. Resource Person -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Resource person" Style="{StaticResource SectionTitle}" />
                        <Label Text="Resume of Resource Person/s (if applicable)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}" Padding="10,8">
                            <Editor x:Name="ResourcePersonResumeEditor"
                                    Placeholder="Names, credentials, summary of resume"
                                    MinimumHeightRequest="100"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 7. Responsible Persons -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Responsible persons" Style="{StaticResource SectionTitle}" />
                        <Label Text="Responsible Person/s" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}" Padding="10,8">
                            <Editor x:Name="ResponsiblePersonsEditor"
                                    Placeholder="Names and roles"
                                    MinimumHeightRequest="72"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Revision notes -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Revision notes" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource InputBorder}" Padding="10,8">
                            <Editor x:Name="RevisionNotesEditor"
                                    Placeholder="Notes for the current review cycle"
                                    MinimumHeightRequest="88"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 8. Signatory / Approval -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Signatory / approval" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource InputBorder}">
                                <VerticalStackLayout Spacing="4" Padding="0,4,0,4">
                                    <Label Text="President" FontSize="12" FontAttributes="Bold" TextColor="#003087" />
                                    <Label x:Name="SignatoryPresidentStatusLabel" Text="Status: —" FontSize="11" TextColor="#5A6E8A" />
                                    <BoxView HeightRequest="1" Color="#E0E8F5" Margin="0,6,0,4" />
                                    <Label Text="Signature / date" FontSize="10" TextColor="#8FA3BF" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource InputBorder}">
                                <VerticalStackLayout Spacing="4" Padding="0,4,0,4">
                                    <Label Text="Adviser" FontSize="12" FontAttributes="Bold" TextColor="#003087" />
                                    <Label x:Name="SignatoryAdviserStatusLabel" Text="Status: —" FontSize="11" TextColor="#5A6E8A" />
                                    <BoxView HeightRequest="1" Color="#E0E8F5" Margin="0,6,0,4" />
                                    <Label Text="Signature / date" FontSize="10" TextColor="#8FA3BF" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource InputBorder}">
                                <VerticalStackLayout Spacing="4" Padding="0,4,0,4">
                                    <Label Text="Program Chair" FontSize="12" FontAttributes="Bold" TextColor="#003087" />
                                    <Label x:Name="SignatoryProgramChairStatusLabel" Text="Status: —" FontSize="11" TextColor="#5A6E8A" />
                                    <BoxView HeightRequest="1" Color="#E0E8F5" Margin="0,6,0,4" />
                                    <Label Text="Signature / date" FontSize="10" TextColor="#8FA3BF" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource InputBorder}">
                                <VerticalStackLayout Spacing="4" Padding="0,4,0,4">
                                    <Label Text="Dean" FontSize="12" FontAttributes="Bold" TextColor="#003087" />
                                    <Label x:Name="SignatoryDeanStatusLabel" Text="Status: —" FontSize="11" TextColor="#5A6E8A" />
                                    <BoxView HeightRequest="1" Color="#E0E8F5" Margin="0,6,0,4" />
                                    <Label Text="Signature / date" FontSize="10" TextColor="#8FA3BF" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Extended workflow (locked preview — same order as institutional web routing) -->
                <Border Style="{StaticResource LockedSectionBorder}">
                    <VerticalStackLayout Spacing="8" IsEnabled="False" Opacity="0.92">
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="#C5D3E8" StrokeShape="RoundRectangle 6" Padding="6,2" Stroke="Transparent">
                                <Label Text="LOCKED PREVIEW" FontSize="9" FontAttributes="Bold" TextColor="#003087" />
                            </Border>
                            <Label Text="Later signatories (SDAO / Academic Services / Directors)"
                                   FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label Text="These rows unlock as the proposal advances; UI only — connect permissions via API later."
                               FontSize="11" TextColor="#5A6E8A" LineBreakMode="WordWrap" />

                        <Border BackgroundColor="#F4F6FB" Stroke="#C5D3E8" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="SDAO Assistant — placeholder" FontSize="12" TextColor="#3D5069" />
                                <Label Text="SDAO Coordinator — placeholder" FontSize="12" TextColor="#3D5069" />
                                <Label Text="Academic Services — placeholder" FontSize="12" TextColor="#3D5069" />
                                <Label Text="Academic Director — placeholder" FontSize="12" TextColor="#3D5069" />
                                <Label Text="Executive Director — placeholder" FontSize="12" TextColor="#3D5069" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Save or leave" Style="{StaticResource SectionTitle}" />
                        <Label Text="Approve and return actions stay on Proposal Details."
                               FontSize="11" TextColor="#8FA3BF" LineBreakMode="WordWrap" />
                        <Button x:Name="CancelEditButton"
                                Text="Back to proposal details"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnCancelEditClicked" />
                        <Button x:Name="SaveDraftButton" Text="Save draft (coming soon)" Style="{StaticResource SecondaryButton}" Clicked="OnSaveDraftClicked" />
                        <Button x:Name="SaveChangesButton" Text="Save my edits" Clicked="OnSaveChangesClicked" />
                        <Button x:Name="SubmitButton" Text="Submit to workflow (coming soon)" Clicked="OnSubmitClicked" />
                        <Button x:Name="ReturnRevisionButton" Text="Return for Revision" BackgroundColor="#DC2626" Clicked="OnReturnForRevisionClicked" />
                        <Button x:Name="ApproveButton" Text="Approve" BackgroundColor="#16A34A" Clicked="OnApproveClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
