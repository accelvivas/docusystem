<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Forms.ActivityRequestFormPage"
             BackgroundColor="{StaticResource White}"
             Title="Activity request">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Page header -->
            <Grid BackgroundColor="#003087" Padding="18,16,18,22">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Activity request form"
                           FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="FormContextSubtitleLabel"
                           Text=""
                           FontSize="11" TextColor="White" Opacity="0.9" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,14,16,24" Spacing="12">

                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="{StaticResource NavyLine}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="12">
                    <Label x:Name="ActivityAccessHintLabel"
                           Text=""
                           FontSize="12" TextColor="{StaticResource PrimaryDarkText}" LineBreakMode="WordWrap" />
                </Border>

                <!-- Section: Organization & activity -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Organization &amp; activity" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name of RSO" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="RsoNameEntry"
                                       Placeholder="Registered student organization name"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="RsoNameValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Title of Activity" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ActivityTitleEntry"
                                       Placeholder="Official activity title"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="ActivityTitleValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Nature of Activity (checklist) -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nature of Activity" Style="{StaticResource SectionTitle}" />
                        <Label Text="Select all that apply."
                               FontSize="11" TextColor="#5A6E8A" />

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <CheckBox x:Name="NatureCoCurricularCheck" VerticalOptions="Center" />
                                <Label Text="Co-Curricular" VerticalTextAlignment="Center" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="NatureNonCurricularCheck" VerticalOptions="Center" />
                                <Label Text="Non-curricular" VerticalTextAlignment="Center" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="NatureCommunityExtensionCheck" VerticalOptions="Center" />
                                <Label Text="Community Extension" VerticalTextAlignment="Center" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="NatureOthersCheck"
                                          VerticalOptions="Center"
                                          CheckedChanged="OnNatureOthersChanged" />
                                <Label Text="Others" VerticalTextAlignment="Center" FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="NatureOthersSpecLayout" Spacing="4" IsVisible="False">
                            <Label Text="Specify (Nature — Others)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="NatureOthersSpecifyEntry"
                                       Placeholder="Please specify"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                        <Label x:Name="NatureActivityValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                    </VerticalStackLayout>
                </Border>

                <!-- Type of Activity (checklist) -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Type of Activity" Style="{StaticResource SectionTitle}" />
                        <Label Text="Select all that apply."
                               FontSize="11" TextColor="#5A6E8A" />

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeSeminarCheck" VerticalOptions="Center" /><Label Text="Seminar/Workshop" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeGeneralAssemblyCheck" VerticalOptions="Center" /><Label Text="General Assembly" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeOrientationCheck" VerticalOptions="Center" /><Label Text="Orientation" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeCompetitionCheck" VerticalOptions="Center" /><Label Text="Competition" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeRecruitmentCheck" VerticalOptions="Center" /><Label Text="Recruitment/Audition" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeDonationDriveCheck" VerticalOptions="Center" /><Label Text="Donation Drive / Fundraising Activity" VerticalTextAlignment="Center" FontSize="13" LineBreakMode="WordWrap" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeOutreachDonationCheck" VerticalOptions="Center" /><Label Text="Outreach (Donation)" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeFundraisingCheck" VerticalOptions="Center" /><Label Text="Fundraising Activity" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><CheckBox x:Name="TypeOffCampusCheck" VerticalOptions="Center" /><Label Text="Off-campus Activity" VerticalTextAlignment="Center" FontSize="13" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="TypeOthersCheck"
                                          VerticalOptions="Center"
                                          CheckedChanged="OnTypeOthersChanged" />
                                <Label Text="Others" VerticalTextAlignment="Center" FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="TypeOthersSpecLayout" Spacing="4" IsVisible="False">
                            <Label Text="Specify (Type — Others)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="TypeOthersSpecifyEntry"
                                       Placeholder="Please specify"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                        <Label x:Name="TypeActivityValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                    </VerticalStackLayout>
                </Border>

                <!-- Logistics & funding -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Partners, SDG, budget &amp; logistics" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Partner Organization(s) / School(s) / RSO" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="10,8">
                                <Editor x:Name="PartnerOrganizationsEditor"
                                        Placeholder="List partners (if any)"
                                        MinimumHeightRequest="72"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Target SDG" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="TargetSdgEntry"
                                       Placeholder="e.g., SDG 4 — Quality Education"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proposed Budget" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="ProposedBudgetEntry"
                                       Placeholder="Amount (PHP)"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="BudgetValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Budget Source" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="BudgetSourceEntry"
                                       Placeholder="Source of funds"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Date of Activity" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}" Padding="8,4">
                                <DatePicker x:Name="ActivityDatePicker"
                                            Format="MMMM dd, yyyy" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Venue" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="VenueEntry"
                                       Placeholder="Venue or location"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="VenueValidationLabel" Style="{StaticResource ValidationHint}" Text="" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Signatory / approval (read-only placeholders for API) -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Signatory / approval routing" Style="{StaticResource SectionTitle}" />
                        <Label Text="Read-only at this template stage. Names and statuses will bind from the server."
                               FontSize="11" TextColor="#5A6E8A" LineBreakMode="WordWrap" />

                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource LockedSectionBorder}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="SDAO Assistant" FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A" />
                                    <Label x:Name="SignatorySdaoAssistantLabel" Text="—" FontSize="13" TextColor="#273B52" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource LockedSectionBorder}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="SDAO Coordinator" FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A" />
                                    <Label x:Name="SignatorySdaoCoordinatorLabel" Text="—" FontSize="13" TextColor="#273B52" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource LockedSectionBorder}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Assistant Director, Academic Services" FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A" />
                                    <Label x:Name="SignatoryAsstDirAcademicLabel" Text="—" FontSize="13" TextColor="#273B52" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource LockedSectionBorder}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Academic Director" FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A" />
                                    <Label x:Name="SignatoryAcademicDirectorLabel" Text="—" FontSize="13" TextColor="#273B52" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource LockedSectionBorder}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Executive Director" FontSize="12" FontAttributes="Bold" TextColor="#5A6E8A" />
                                    <Label x:Name="SignatoryExecutiveDirectorLabel" Text="—" FontSize="13" TextColor="#273B52" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Approved request letter — required content -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Approved request letter — required content" Style="{StaticResource SectionTitle}" />
                        <Label Text="The approved activity request letter should include the following attachments or sections:"
                               FontSize="12" TextColor="#3D5069" LineBreakMode="WordWrap" />
                        <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                            <Label Text="• Rationale" FontSize="12" TextColor="#273B52" />
                            <Label Text="• Objectives" FontSize="12" TextColor="#273B52" />
                            <Label Text="• Program" FontSize="12" TextColor="#273B52" />
                            <Label Text="• Resume of speaker" FontSize="12" TextColor="#273B52" />
                            <Label Text="• Post-survey form" FontSize="12" TextColor="#273B52" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Revision notes (collaboration) -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Revision notes" Style="{StaticResource SectionTitle}" />
                        <Label Text="Placeholder for reviewer comments or revision instructions (API later)."
                               FontSize="11" TextColor="#8FA3BF" />
                        <Border Style="{StaticResource InputBorder}" Padding="10,8">
                            <Editor x:Name="RevisionNotesEditor"
                                    Placeholder="Revision notes…"
                                    MinimumHeightRequest="88"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Actions" Style="{StaticResource SectionTitle}" />
                        <Button x:Name="SaveDraftButton"
                                Text="Save Draft"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnSaveDraftClicked" />
                        <Button x:Name="SubmitButton"
                                Text="Submit"
                                Clicked="OnSubmitClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
