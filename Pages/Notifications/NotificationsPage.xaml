<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Notifications.NotificationsPage"
             BackgroundColor="{StaticResource White}"
             Title="Notifications">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Navy Page Header -->
        <Grid Grid.Row="0" BackgroundColor="#003087" Padding="18,16,18,20" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Label Text="Notifications" FontSize="20" FontAttributes="Bold" TextColor="White" />
                <Label Text="Approver workflow updates for pending, returned, approved, and status changes."
                       FontSize="12" TextColor="White" Opacity="0.9" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="#FFFFFF22"
                    Stroke="#FFFFFF55"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,6"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Unread" FontSize="11" TextColor="White" />
                    <Label x:Name="UnreadCountLabel"
                           Text="0"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="White" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Filter Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                Margin="16,12,16,0">
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="8" Padding="0,2,0,2">
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterAllBtn"
                            Text="All"
                            Clicked="OnFilterClicked"
                            ClassId="All" />
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterApprovalBtn"
                            Text="Pending"
                            Clicked="OnFilterClicked"
                            ClassId="Pending" />
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterRevisionBtn"
                            Text="Returned"
                            Clicked="OnFilterClicked"
                            ClassId="Returned" />
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterApprovedBtn"
                            Text="Approved"
                            Clicked="OnFilterClicked"
                            ClassId="Approved" />
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterRejectedBtn"
                            Text="Rejected"
                            Clicked="OnFilterClicked"
                            ClassId="Rejected" />
                    <Button Style="{StaticResource ChipButton}"
                            x:Name="FilterStatusBtn"
                            Text="Status Updates"
                            Clicked="OnFilterClicked"
                            ClassId="StatusUpdates" />
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <VerticalStackLayout Grid.Row="2"
                             Padding="16,8,16,0"
                             Spacing="6">
            <Button x:Name="MarkAllReadBtn"
                    Text="Mark all as read"
                    FontSize="12"
                    HorizontalOptions="End"
                    Clicked="OnMarkAllReadClicked"
                    IsVisible="False"
                    TextColor="{StaticResource Primary}" />
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />
            <Label x:Name="ErrorStateLabel"
                   IsVisible="False"
                   FontSize="12"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- Notifications List -->
        <RefreshView
            x:Name="NotificationsRefresh"
            Grid.Row="3"
            RefreshColor="#003087"
            Refreshing="OnNotificationsRefreshing">
            <ScrollView>
                <VerticalStackLayout x:Name="NotificationsStack" Padding="16,12,16,20" Spacing="10" />
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
