<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="docusystem.Pages.Approvals.ProposalDetailsPage"
             BackgroundColor="#F4F6FA"
             Title="Review proposal">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Navy header -->
            <Grid BackgroundColor="{StaticResource Primary}" Padding="18,16,18,20">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="MyRoleLabel"
                           Text="Role: —"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="White" Opacity="0.85" />
                    <Label x:Name="TitleLabel"
                           Text="Proposal"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="WordWrap" />
                    <Label x:Name="OrganizationLabel"
                           Text="Organization"
                           FontSize="12" TextColor="White" Opacity="0.9" />
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Border x:Name="StatusBadgeBorder"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                Padding="10,5">
                            <Label x:Name="StatusLabel" Text="Pending"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                        <Border BackgroundColor="{StaticResource PrimaryMid}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                Padding="10,5">
                            <Label x:Name="StageHeroLabel" Text="Stage: —"
                                   FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Border BackgroundColor="#EAF0FC"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                Padding="10,5">
                            <Label x:Name="CurrentApproverBadgeLabel"
                                   Text="Current Approver: —"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#003087" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="14,14,14,28" Spacing="14">

                <!-- Summary card (2-col grid) -->
                <Border BackgroundColor="White"
                        Stroke="#E0E4ED"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Row 0 -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="DOCUMENT TYPE" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="DocTypeLabel" Text="Activity Proposal"
                                   FontSize="13" TextColor="#1A2340" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="ORGANIZATION" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummaryOrgLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <!-- Row 1 -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="SUBMITTED BY" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummarySubmittedByLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="SUBMITTED ON" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummarySubmittedOnLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" />
                        </VerticalStackLayout>
                        <!-- Row 2 -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                            <Label Text="CURRENT STEP" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummaryCurrentStepLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                            <Label Text="ACTIVITY TITLE" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummaryTitleLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <!-- Row 3 -->
                        <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="2">
                            <Label Text="PROPOSED DATES" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummaryDatesLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                            <Label Text="VENUE" FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" Opacity="0.6" />
                            <Label x:Name="SummaryVenueLabel" Text="—"
                                   FontSize="13" TextColor="#1A2340" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Field review progress -->
                <Border BackgroundColor="White"
                        Stroke="#E0E4ED"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Field review progress"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="#1A2340" />
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="#E8F5EF"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="#3CB371"
                                    StrokeThickness="1"
                                    Padding="10,4">
                                <Label x:Name="VerifiedCountLabel" Text="Verified: 0"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#1A7A45" />
                            </Border>
                            <Border BackgroundColor="#FFF4E6"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="#E08030"
                                    StrokeThickness="1"
                                    Padding="10,4">
                                <Label x:Name="RevisionCountLabel" Text="Revision: 0"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#C06000" />
                            </Border>
                            <Border BackgroundColor="#F4F6FA"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="#C0C8D8"
                                    StrokeThickness="1"
                                    Padding="10,4">
                                <Label x:Name="PendingCountLabel" Text="Pending: 2"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#5A6A8A" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 1: Submission overview -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Step 1: Activity Request Form"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1A2340"
                               VerticalTextAlignment="Center" />
                        <Border Grid.Column="1"
                                x:Name="Step1Badge"
                                BackgroundColor="#F4F6FA"
                                StrokeShape="RoundRectangle 20"
                                Stroke="#E0E4ED"
                                Padding="10,4">
                            <Label x:Name="Step1BadgeLabel" Text="Pending"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#5A6A8A" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="Step1FieldsStack" Spacing="8" />
                </VerticalStackLayout>

                <!-- Section 2: Proposal Submission -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Step 2: Proposal Submission"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1A2340"
                               VerticalTextAlignment="Center" />
                        <Border Grid.Column="1"
                                x:Name="Step2Badge"
                                BackgroundColor="#F4F6FA"
                                StrokeShape="RoundRectangle 20"
                                Stroke="#E0E4ED"
                                Padding="10,4">
                            <Label x:Name="Step2BadgeLabel" Text="Pending"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#5A6A8A" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="Step2FieldsStack" Spacing="8" />
                </VerticalStackLayout>

                <!-- Revision / approval summary -->
                <Border x:Name="ReviewSummaryCard"
                        BackgroundColor="#E8F5EF"
                        Stroke="#A8D8BA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="REVISION SUMMARY"
                               FontSize="10" FontAttributes="Bold"
                               TextColor="#1A7A45" />
                        <Label x:Name="ReviewSummaryLabel"
                               Text="Review all fields to see summary."
                               FontSize="12"
                               TextColor="#1A4030"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Submit Field Review button (approver only) -->
                <Button x:Name="SubmitFieldReviewBtn"
                        Text="Submit Field Review"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="12"
                        Padding="16,14"
                        IsVisible="False"
                        Clicked="OnSubmitFieldReviewClicked" />

                <!-- Approval workflow -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Approval workflow"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="#1A2340" />

                    <!-- Horizontal workflow track -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="WorkflowTrackStack"
                                               Spacing="0"
                                               Padding="2,6,2,6" />
                    </ScrollView>

                    <!-- Selected stage detail card -->
                    <Border x:Name="SelectedStageCard"
                            BackgroundColor="White"
                            Stroke="#E0E4ED"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="SELECTED STAGE" FontSize="9" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" Opacity="0.6" />
                                <Label x:Name="SelectedStageLabel" Text="—"
                                       FontSize="13" FontAttributes="Bold" TextColor="#1A2340" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="STATUS" FontSize="9" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" Opacity="0.6" />
                                <Label x:Name="SelectedStageStatusLabel" Text="—"
                                       FontSize="13" TextColor="#1A2340" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="REVIEWER" FontSize="9" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" Opacity="0.6" />
                                <Label x:Name="SelectedStageReviewerLabel" Text="—"
                                       FontSize="13" TextColor="#1A2340" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="2">
                                <Label Text="ACTED AT" FontSize="9" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" Opacity="0.6" />
                                <Label x:Name="SelectedStageActedAtLabel" Text="—"
                                       FontSize="13" TextColor="#1A2340" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Recent workflow logs -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Recent workflow logs"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#1A2340" />
                    <VerticalStackLayout x:Name="WorkflowLogsStack" Spacing="4" />
                </VerticalStackLayout>

                <!-- Returned remarks (visible when returned) -->
                <Border x:Name="ReturnedRemarksPanel"
                        IsVisible="False"
                        BackgroundColor="#FFF0F0"
                        Stroke="#E08080"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Returned — reviewer remarks"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="#A00000" />
                        <Label x:Name="ReturnedRemarksBodyLabel"
                               FontSize="13" TextColor="#3A1010"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Resubmit (RSO President only, when returned) -->
                <Button x:Name="ResubmitBtn"
                        Text="Resubmit for review"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="2"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Padding="16,14"
                        IsVisible="False"
                        Clicked="OnResubmitForReviewClicked" />

                <!-- Fully approved banner -->
                <Border x:Name="DigitalApprovalBanner"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="Transparent"
                        Padding="18,16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✓  FULLY APPROVED"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="All required sign-offs are complete."
                               FontSize="12" TextColor="White" Opacity="0.9" />
                        <Label x:Name="ApprovalTimestampLabel"
                               Text="—"
                               FontSize="11" TextColor="White" Opacity="0.85" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
